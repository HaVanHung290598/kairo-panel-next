# Mẫu cho .env.development.local — cấu hình CHỈ của máy dev (Mac), dùng với `npm run dev:local`.
#
# Next chỉ nạp .env.development.local khi `next dev` (ưu tiên cao hơn .env.local), và .dockerignore
# loại `.env*.local` nên file này không bao giờ vào ảnh deploy. Env của CỤM (app-key, SDK, tenant…)
# vẫn nằm ở .env.local — "local" ở tên file đó là cụm trên server kairos 192.168.110.33, không
# phải máy dev.

# Bắt buộc: báo cho app biết đang chạy trên máy dev → trình duyệt đi qua proxy cùng origin /kairo/*.
KAIRO_RUNTIME=dev-machine

# Cổng mở trình duyệt (proxy) và cổng nội bộ của next dev.
PORT=3100
KAIRO_DEV_NEXT_PORT=3190
# 127.0.0.1: chỉ máy này vào được (máy dùng chung). Đổi 0.0.0.0 nếu cần mở cho máy khác trong LAN.
KAIRO_DEV_HOST=127.0.0.1

# Đích chuyển tiếp — cụm kairos-viper trên server kairos (gọi thẳng IP LAN, không qua NAT).
KAIRO_DEV_PROXY_API=http://192.168.110.33:58080
KAIRO_DEV_PROXY_CDN=http://192.168.110.33:5180
KAIRO_DEV_PROXY_LIVEKIT=http://192.168.110.33:7880

# Origin trình bày với bff-tenant — phải nằm trong CORS của cụm (TENANT_CORS_DOMAIN).
KAIRO_DEV_PROXY_ORIGIN=http://cardoctor.tienloixanh.org:8765

# CHỈ biến của máy dev ở đây. Biến của cụm/môi trường (KAIRO_GUEST_TENANT, DEMO_V2_USER_EMAIL,
# KAIRO_ENDUSER_URL, app-key…) khai ở .env.local như trên server — xem .env.example.
