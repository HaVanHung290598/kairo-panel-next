# Chép file này thành .env.local (hoặc .env.sit.local / .env.uat.local) rồi điền giá trị thật của
# MỘT môi trường. Tất cả đều là biến SERVER (không có tiền tố NEXT_PUBLIC_) — app-key không bao giờ
# xuống browser. Đọc lúc CHẠY: đổi env chỉ cần restart container, không build lại.
#
# Máy dev (Mac) chạy `npm run dev:local` còn cần thêm .env.development.local — xem
# .env.development.example (chỉ cấu hình proxy của máy dev, không lặp lại biến ở đây).

# ───────── Kairo REST SDK — server xin user + token ─────────
KAIRO_SDK_BASE_URL=https://api.sit.yousee.vn
# App-key của tenant. Trang /v2 cần key có phạm vi `v2` (bật ở màn S21 của tenant-admin).
KAIRO_APP_KEY=ak.xxxxxxxx.xxxxxxxx.xxxxxxxx
# Tiền tố route v1. Bỏ trống biến = `/sdk` (SIT/UAT có gateway). Cụm gọi thẳng service sdk
# (server kairos .33) khai RỖNG: `KAIRO_SDK_PATH_PREFIX=`.
# KAIRO_SDK_PATH_PREFIX=
# Tiền tố route v2. Mặc định `/sdk/v2` — service sdk luôn phục vụ v2 ở đó.
# KAIRO_SDK_V2_PATH_PREFIX=/sdk/v2

# ───────── Tenant API — browser gọi thẳng (server chỉ chuyển giá trị qua /api/config) ─────────
KAIRO_GRAPHQL_URL=https://api.sit.yousee.vn/bff-tenant/graphql
KAIRO_WS_URL=wss://api.sit.yousee.vn/bff-tenant/ws
# Signaling LiveKit cho cuộc gọi của panel v2. Bỏ trống = <origin graphql>/livekit.
KAIRO_LIVEKIT_URL=

# ───────── Artifact nhúng ─────────
# URL CloudFront chính thức — KHÔNG suy từ KAIRO_SDK_BASE_URL (xem "Môi trường & Base URL").
# Trỏ bản v1 hay v2 đều được: app lấy GỐC rồi dựng cả `<gốc>/kairo-widget.js` (trang / và /gara)
# lẫn `<gốc>/sdk/v2/kairo-widget.js` (trang /v2/*).
KAIRO_WIDGET_JS_URL=https://d3ikqcrv5ojj7m.cloudfront.net/kairo-widget.js
# Chỉ khai khi hai bản KHÔNG nằm chung một gốc.
# KAIRO_WIDGET_V1_JS_URL=
# KAIRO_WIDGET_V2_JS_URL=
KAIRO_SW_JS_URL=https://d3ikqcrv5ojj7m.cloudfront.net/kairo-sw.js

# ───────── Tenant ─────────
# Slug tenant cho widget khách vãng lai (/gara, /v2/gara). Sai slug thì bubble mở nhầm hộp thư
# công ty khác, nên biến này BẮT BUỘC, không có giá trị mặc định.
KAIRO_GUEST_TENANT=hunghv3
# Slug tenant của APP-KEY (màu/logo panel, "không gian" in ở trang tự tạo tài khoản). Bỏ trống =
# dùng lại KAIRO_GUEST_TENANT; chỉ khai khi hai tenant khác nhau.
# KAIRO_TENANT_SLUG=

# Web-enduser của CÙNG môi trường — link đăng nhập sau khi tự tạo tài khoản + link mời đối tác
# `/doi-tac/moi?token=`. Nên trùng PARTNER_INVITE_BASE_URL của bff-tenant. Bỏ trống = trang ẩn link.
KAIRO_ENDUSER_URL=

# ───────── Người "đang đăng nhập" của phần mềm doanh nghiệp ─────────
# v1 (/): user do app tự tạo qua /v1/users. Bỏ trống thì dùng mặc định trong src/server/kairo.ts.
DEMO_USER_ID=
DEMO_USER_NAME=
# v2 (/v2/*): một user CÓ SẴN trong tenant của app-key — BẮT BUỘC cho trang v2, không có mặc định.
# Khai email HOẶC userId.
DEMO_V2_USER_EMAIL=
# DEMO_V2_USER_ID=
